# Configuración de Supabase
# ATENCIÓN: usa la SERVICE ROLE key (Settings → API), no la anon.
# La anon no puede escribir en las tablas y el agente no podrá registrar
# pacientes ni conversaciones. Formatos nuevos: sb_secret_... / sb_publishable_...
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-service-role-key

# Configuración de Google Gemini (Gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu-gemini-api-key

# Modelos a probar, en orden de preferencia. Si el primero falla (retirado o
# caído), se prueba el siguiente automáticamente.
# OJO: la cuota del nivel gratuito es POR PROYECTO, no por modelo. Configurar
# tres modelos no da tres veces más cuota, y un 429 ya no prueba el siguiente.
# gemini-2.5-flash-lite devuelve 404 en cuentas nuevas: esta retirado.
# respaldo correcto hoy es gemini-3.5-flash-lite.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash

# Presupuesto de tokens de salida. Los modelos flash reservan parte de este
# valor para razonar en silencio, así que un número bajo hace que la respuesta
# visible se corte a media frase. 1024 sobra para un mensaje de WhatsApp.
GEMINI_MAX_OUTPUT_TOKENS=1024

# Tokens de razonamiento interno (0 = desactivado).
# Para responder WhatsApp no aporta nada y encarece la respuesta.
GEMINI_THINKING_BUDGET=0

# Secreto compartido que la centralita o Evolution API deben enviar en la
# cabecera X-Webhook-Secret. Si lo dejas vacío, /api/webhook/whatsapp queda
# CERRADO (devuelve 503). Genéralo con: openssl rand -hex 32
WEBHOOK_SECRET=

# Configuración de WhatsApp (Evolution API, Baileys o Meta Cloud API)
# Si lo dejas vacío, el sistema funciona en MODO SIMULACIÓN para pruebas locales
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE_NAME=clinica_demo

# Servidor
PORT=8000
HOST=0.0.0.0
